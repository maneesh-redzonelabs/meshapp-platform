# Base URL for the MeshApp API, including version prefix.
#
# - iOS Simulator (Mac):           http://localhost:4000/v1
# - Android Emulator (AVD):        http://10.0.2.2:4000/v1   (the emulator's alias for the host machine's localhost)
# - Physical device (Expo Go):     http://<your-computer-LAN-IP>:4000/v1   (e.g. http://192.168.1.50:4000/v1)
# - Production:                    https://api.meshapp.ai/v1
#
# Expo only exposes env vars prefixed with EXPO_PUBLIC_ to client code
# (via process.env.EXPO_PUBLIC_API_BASE_URL). Copy this file to `.env` and
# edit it; restart `expo start -c` after changing it so Metro picks it up.
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000/v1
