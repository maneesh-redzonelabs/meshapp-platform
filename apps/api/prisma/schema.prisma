generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["meshapp", "public"]
}

model admin_actions_log {
  action_id       String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  admin_id        String          @db.Uuid
  action_type     String          @db.VarChar(100)
  target_user_id  String?         @db.Uuid
  entity_type     String?         @db.VarChar(100)
  entity_id       String?         @db.Uuid
  reason          String?
  notes           String?
  performed_at    DateTime        @default(now()) @db.Timestamptz(6)
  users           users?          @relation(fields: [target_user_id], references: [user_id], onUpdate: NoAction)
  platform_admins platform_admins @relation(fields: [admin_id], references: [admin_id], onUpdate: NoAction, map: "fk_admin_action_admin")

  @@schema("meshapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model appointments {
  appointment_id                                                         String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  patient_id                                                             String                   @db.Uuid
  family_member_id                                                       String?                  @db.Uuid
  doctor_id                                                              String                   @db.Uuid
  location_id                                                            String?                  @db.Uuid
  appointment_date                                                       DateTime                 @db.Date
  start_time                                                             DateTime                 @db.Time(6)
  end_time                                                               DateTime?                @db.Time(6)
  appointment_type                                                       appointment_type_enum
  status                                                                 appointment_status_enum  @default(requested)
  consultation_fee                                                       Decimal                  @db.Decimal(10, 2)
  platform_service_fee                                                   Decimal                  @default(0) @db.Decimal(10, 2)
  total_amount                                                           Decimal                  @db.Decimal(10, 2)
  payment_status                                                         payment_status_enum      @default(pending)
  payment_id                                                             String?                  @db.Uuid
  rescheduled_from                                                       String?                  @db.Uuid
  patient_notes                                                          String?
  video_session_id                                                       String?                  @db.Uuid
  cancellation_reason                                                    String?
  cancelled_by                                                           cancelled_by_enum?
  created_at                                                             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                                                             DateTime?                @db.Timestamptz(6)
  doctors                                                                doctors                  @relation(fields: [doctor_id], references: [doctor_id], onUpdate: NoAction)
  patient_family_members                                                 patient_family_members?  @relation(fields: [family_member_id], references: [family_member_id], onUpdate: NoAction)
  doctor_clinic_locations                                                doctor_clinic_locations? @relation(fields: [location_id], references: [location_id], onUpdate: NoAction)
  patients                                                               patients                 @relation(fields: [patient_id], references: [patient_id], onUpdate: NoAction)
  payments                                                               payments?                @relation(fields: [payment_id], references: [payment_id], onUpdate: NoAction)
  appointments                                                           appointments?            @relation("appointmentsToappointments", fields: [rescheduled_from], references: [appointment_id], onUpdate: NoAction)
  other_appointments                                                     appointments[]           @relation("appointmentsToappointments")
  video_call_sessions_appointments_video_session_idTovideo_call_sessions video_call_sessions?     @relation("appointments_video_session_idTovideo_call_sessions", fields: [video_session_id], references: [session_id], onUpdate: NoAction)
  prescriptions                                                          prescriptions?
  video_call_sessions_video_call_sessions_appointment_idToappointments   video_call_sessions?     @relation("video_call_sessions_appointment_idToappointments")

  @@index([appointment_date, status], map: "idx_appt_date_status")
  @@index([doctor_id, appointment_date, status], map: "idx_appt_doctor_date")
  @@index([patient_id, status], map: "idx_appt_patient")
  @@schema("meshapp")
}

model bot_response_templates {
  template_id      Int       @id @default(autoincrement())
  keyword_triggers String[]  @default([])
  response_text    String
  category         String?   @db.VarChar(100)
  priority         Int       @default(0) @db.SmallInt
  is_active        Boolean   @default(true)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime? @db.Timestamptz(6)

  @@index([keyword_triggers], map: "idx_bot_triggers", type: Gin)
  @@schema("meshapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model communities {
  community_id          String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  community_name        String                  @db.VarChar(255)
  description           String?
  speciality_id         Int?                    @db.SmallInt
  created_by            String                  @db.Uuid
  member_count          Int                     @default(0)
  is_public             Boolean                 @default(true)
  is_active             Boolean                 @default(true)
  created_at            DateTime                @default(now()) @db.Timestamptz(6)
  updated_at            DateTime?               @db.Timestamptz(6)
  users                 users                   @relation(fields: [created_by], references: [user_id], onUpdate: NoAction)
  medical_specialities  medical_specialities?   @relation(fields: [speciality_id], references: [speciality_id], onUpdate: NoAction)
  community_memberships community_memberships[]
  posts                 posts[]

  @@schema("meshapp")
}

model community_memberships {
  membership_id String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  community_id  String              @db.Uuid
  user_id       String              @db.Uuid
  role          community_role_enum @default(member)
  joined_at     DateTime            @default(now()) @db.Timestamptz(6)
  is_active     Boolean             @default(true)
  communities   communities         @relation(fields: [community_id], references: [community_id], onDelete: Cascade, onUpdate: NoAction)
  users         users               @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([community_id, user_id])
  @@schema("meshapp")
}

model content_compliance_rules {
  rule_id    Int                      @id @default(autoincrement())
  category   String                   @db.VarChar(150)
  pattern    String
  severity   compliance_severity_enum @default(block)
  guidance   String
  source_ref String?                  @db.VarChar(255)
  is_active  Boolean                  @default(true)
  created_at DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at DateTime?                @db.Timestamptz(6)

  @@schema("meshapp")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model content_compliance_scans {
  scan_id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  entity_type         compliance_entity_type_enum
  entity_id           String?                     @db.Uuid
  user_id             String                      @db.Uuid
  scanned_text        String
  verdict             compliance_verdict_enum
  matched_rules       Json?
  scanned_at          DateTime                    @default(now()) @db.Timestamptz(6)
  users               users                       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  doctor_achievements doctor_achievements[]
  doctor_publications doctor_publications[]
  equipment_listings  equipment_listings[]
  posts               posts[]

  @@index([entity_type, entity_id], map: "idx_compliance_scans_entity")
  @@index([user_id, scanned_at(sort: Desc)], map: "idx_compliance_scans_user")
  @@index([verdict, scanned_at(sort: Desc)], map: "idx_compliance_scans_verdict")
  @@schema("meshapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model doctor_achievements {
  achievement_id           String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id                String                   @db.Uuid
  achievement_text         String
  achievement_year         Int?                     @db.SmallInt
  awarding_body            String?                  @db.VarChar(255)
  compliance_scan_id       String                   @db.Uuid
  created_at               DateTime                 @default(now()) @db.Timestamptz(6)
  content_compliance_scans content_compliance_scans @relation(fields: [compliance_scan_id], references: [scan_id], onDelete: NoAction, onUpdate: NoAction)
  doctors                  doctors                  @relation(fields: [doctor_id], references: [doctor_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([doctor_id], map: "idx_doc_achieve")
  @@schema("meshapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model doctor_affiliations {
  affiliation_id String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id      String    @db.Uuid
  job_title      String    @db.VarChar(200)
  hospital_name  String    @db.VarChar(255)
  from_year      Int       @db.SmallInt
  to_year        Int?      @db.SmallInt
  is_current     Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @db.Timestamptz(6)
  doctors        doctors   @relation(fields: [doctor_id], references: [doctor_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([doctor_id], map: "idx_doc_affil")
  @@schema("meshapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model doctor_availability_slots {
  slot_id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id               String                   @db.Uuid
  location_id             String?                  @db.Uuid
  day_of_week             Int                      @db.SmallInt
  start_time              DateTime                 @db.Time(6)
  end_time                DateTime                 @db.Time(6)
  slot_duration_minutes   Int                      @default(30) @db.SmallInt
  max_patients            Int                      @default(1) @db.SmallInt
  slot_type               slot_type_enum           @default(both)
  is_active               Boolean                  @default(true)
  created_at              DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at              DateTime?                @db.Timestamptz(6)
  doctors                 doctors                  @relation(fields: [doctor_id], references: [doctor_id], onDelete: Cascade, onUpdate: NoAction)
  doctor_clinic_locations doctor_clinic_locations? @relation(fields: [location_id], references: [location_id], onUpdate: NoAction)

  @@schema("meshapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model doctor_blocked_dates {
  blocked_id    String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id     String            @db.Uuid
  blocked_date  DateTime          @db.Date
  blocked_type  blocked_type_enum @default(full_day)
  blocked_start DateTime?         @db.Time(6)
  blocked_end   DateTime?         @db.Time(6)
  reason        String?           @db.VarChar(255)
  created_at    DateTime          @default(now()) @db.Timestamptz(6)
  doctors       doctors           @relation(fields: [doctor_id], references: [doctor_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([doctor_id, blocked_date], map: "idx_blocked_doc_date")
  @@schema("meshapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model doctor_clinic_locations {
  location_id               String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id                 String                      @db.Uuid
  clinic_hospital_name      String                      @db.VarChar(255)
  address_line1             String?                     @db.VarChar(255)
  address_line2             String?                     @db.VarChar(255)
  city                      String?                     @db.VarChar(100)
  state                     String?                     @db.VarChar(100)
  pin_code                  String?                     @db.VarChar(10)
  country                   String                      @default("India") @db.VarChar(100)
  latitude                  Decimal                     @db.Decimal(10, 8)
  longitude                 Decimal                     @db.Decimal(11, 8)
  geolocation               Unsupported("geography")
  consultation_fee_inperson Decimal?                    @db.Decimal(10, 2)
  consultation_fee_video    Decimal?                    @db.Decimal(10, 2)
  is_primary                Boolean                     @default(true)
  is_active                 Boolean                     @default(true)
