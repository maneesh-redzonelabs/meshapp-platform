  parent_category_id         Int?                   @db.SmallInt
  is_active                  Boolean                @default(true)
  sort_order                 Int?                   @db.SmallInt
  equipment_categories       equipment_categories?  @relation("equipment_categoriesToequipment_categories", fields: [parent_category_id], references: [category_id], onUpdate: NoAction)
