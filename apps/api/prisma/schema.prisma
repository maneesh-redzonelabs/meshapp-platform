model doctor_verification_documents {
  document_id         String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  doctor_id           String                 @db.Uuid
  document_type       document_type_enum
  nmc_registration_no String?                @unique @db.VarChar(100)
  file_path           String                 @db.VarChar(500)
  file_hash           String?                @db.VarChar(64)
  review_status       doc_review_status_enum @default(pending)
  reviewed_by         String?                @db.Uuid
  reviewed_at         DateTime?              @db.Timestamptz(6)
  rejection_reason    String?
  uploaded_at         DateTime               @default(now()) @db.Timestamptz(6)
  doctors             doctors                @relation(fields: [doctor_id], references: [doctor_id], onDelete: Cascade, onUpdate: NoAction)
  users               users?                 @relation(fields: [reviewed_by], references: [user_id], onUpdate: NoAction)

  @@index([doctor_id], map: "idx_verif_doc_doctor")
  @@schema("meshapp")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model doctors {
  doctor_id                     String                          @id @db.Uuid
  full_name                     String                          @db.VarChar(200)
  profile_selfie_url            String?                         @db.VarChar(500)
  speciality_id                 Int                             @db.SmallInt
  subspeciality_id              Int                             @db.SmallInt
  subscription_tier             subscription_tier_enum          @default(free)
  bio                           String?
  years_of_experience           Int?                            @db.SmallInt
  is_searchable                 Boolean                         @default(false)
  verification_status           verification_status_enum        @default(unverified)
  rating_avg                    Decimal?                        @db.Decimal(3, 2)
  rating_count                  Int                             @default(0)
  profile_completeness_pct      Int                             @default(0) @db.SmallInt
  backdrop_image_url            String?                         @db.VarChar(500)
  created_at                    DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at                    DateTime?                       @db.Timestamptz(6)
  deleted_at                    DateTime?                       @db.Timestamptz(6)
  appointments                  appointments[]
  doctor_achievements           doctor_achievements[]
  doctor_affiliations           doctor_affiliations[]
  doctor_availability_slots     doctor_availability_slots[]
  doctor_blocked_dates          doctor_blocked_dates[]
  doctor_clinic_locations       doctor_clinic_locations[]
  doctor_education              doctor_education[]
  doctor_publications           doctor_publications[]
  doctor_verification_documents doctor_verification_documents[]
  users                         users                           @relation(fields: [doctor_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  medical_specialities          medical_specialities            @relation(fields: [speciality_id], references: [speciality_id], onUpdate: NoAction)
  medical_subspecialities       medical_subspecialities         @relation(fields: [subspeciality_id], references: [subspeciality_id], onUpdate: NoAction)
  medico_legal_consultations    medico_legal_consultations[]
  prescriptions                 prescriptions[]

  @@index([speciality_id, subspeciality_id], map: "idx_doctors_spec")
  @@index([subscription_tier], map: "idx_doctors_tier")
  @@index([verification_status], map: "idx_doctors_verif")
  @@schema("meshapp")
}

