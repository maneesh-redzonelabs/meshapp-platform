# Copy to .env and fill in real values. NEVER commit .env.

# --- Database -----------------------------------------------------------
# Postgres 18 + PostGIS, schema "meshapp". Prisma multiSchema reads both
# "meshapp" (app tables) and "public" (extensions / search_path fallback).
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/postgres?schema=meshapp"

# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- Auth / JWT -------------------------------------------------------------
# HS256 shared secrets for local dev. Rotate and move to RS256 + KMS in prod.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_DAYS=30

# --- OTP (mock delivery; see README "Mock vs Real integrations") ------------
# When true (dev only), OTP API responses include data.debug_otp with the
# plaintext code so the web/mobile apps can test without a real SMS/email
# provider. Must be false/absent whenever NODE_ENV != development.
MOCK_OTP_EXPOSE=true
OTP_LENGTH=4
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=3

# --- File storage (local disk dev substitute for S3) ------------------------
UPLOADS_DIR=./uploads
UPLOAD_BASE_URL=http://localhost:4000/uploads

# --- Rate limiting (relaxed for local dev; see README) ----------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_DEFAULT=300

# --- Idempotency ------------------------------------------------------------
IDEMPOTENCY_TTL_MINUTES=60

# --- CORS --------------------------------------------------------------------
CORS_ORIGIN=http://localhost:5173,http://localhost:19006
