{
  "name": "meshapp-platform",
  "version": "1.0.0",
  "private": true,
  "description": "MeshApp AI — Doctors Professional Partner (DPP) platform monorepo: Node.js API, React web client, React Native (Expo) mobile client.",
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/shared"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "build:api": "npm run build --workspace apps/api",
    "build:web": "npm run build --workspace apps/web",
    "build:shared": "npm run build --workspace packages/shared",
    "lint": "npm run lint --workspace apps/api && npm run lint --workspace apps/web"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "argon2@0.41.1": true,
    "esbuild@0.28.2": true,
    "esbuild@0.21.5": true,
    "prisma@5.22.0": true
  }
}
